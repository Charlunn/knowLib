# ──────────────────────────────────────────────────────────────────────
# knowLib 环境变量样板
# 复制为 .env 后,运行 scripts/bootstrap.sh 自动填充随机生成的字段
# ──────────────────────────────────────────────────────────────────────

# === 公网域名 (Caddy 自动 HTTPS) ===
DOMAIN=knowlib.example.com

# === CouchDB ===
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-strong-random
# Obsidian LiveSync 端用的普通账号
COUCHDB_OBSIDIAN_USER=obsidian
COUCHDB_OBSIDIAN_PASSWORD=change-me-strong-random
COUCHDB_DB=obsidian-vault

# === LiveSync 端到端加密密钥 ===
# bootstrap.sh 生成,Obsidian 客户端首次连库时手动输入同一份
# 丢失 = 历史数据无法解密。请抄到密码管理器
E2E_PASSPHRASE=change-me-very-long-random

# === knowlib-api ===
JWT_SECRET=change-me-random-64-bytes
TOTP_ISSUER=knowLib
TOTP_ACCOUNT=me
# bootstrap.sh 生成 TOTP secret 并打印 QR 码到终端
TOTP_SECRET=

# === LLM (OpenAI 兼容,用户可在 Web 设置页改) ===
# 默认用 DeepSeek;可换成中转站、本地 vLLM 等
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_MODEL=deepseek-chat

# === Embedding 服务(OpenAI 兼容 /v1/embeddings)===
# 默认用 embedder 容器内本地 bge-m3
EMBED_BASE_URL=http://embedder:8000/v1
EMBED_MODEL=bge-m3

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowlib_notes

# === 路径(容器内) ===
VAULT_PATH=/data/vault
INBOX_DIR=inbox
NOTES_DIR=notes
ATLAS_DIR=atlas
KNOWLIB_DIR=.knowlib

# === 整理行为(Phase 1 仅手动)===
TIDY_TOP_K=8
TIDY_MAX_TOKENS=4096

# === 时区 ===
TZ=Asia/Shanghai

# === WebDAV (Obsidian Remotely Save 同步) ===
WEBDAV_USER=obsidian
WEBDAV_PASSWORD=change-me-strong-random
