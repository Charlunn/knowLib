# Caddyfile.behind-nginx
# 宿主 nginx 处理 TLS，转发明文到容器 8080。
# Caddy 在此只做内部服务路由，不管证书。
{
	auto_https off
}

:8080 {
	encode zstd gzip

	# === WebDAV for Obsidian Remotely Save ===
	# Obsidian 配置: https://<domain>/dav
	handle /dav* {
		uri strip_prefix /dav
		reverse_proxy webdav:80
	}

	# === Obsidian LiveSync (CouchDB) — 保留兼容，暂不使用 ===
	# handle_path /sync/* {
	# 	reverse_proxy couchdb:5984
	# }

	# === MCP server (SSE + JSON-RPC) ===
	handle /mcp* {
		reverse_proxy api:8080
	}

	# === REST API ===
	handle /api/* {
		reverse_proxy api:8080
	}

	# === Web 前端 (Next.js) ===
	handle {
		reverse_proxy web:3000
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}
